# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Optional custom production domain for SEO canonical tags & social preview cards.
# When omitted, the app dynamically uses window.location.origin in the browser or the request host on the server.
# Configure this only once your official production domain has been provisioned (e.g. "https://yourdomain.com").
VITE_SITE_URL=""

# RESEND_API_KEY: Provider key for reliable transactional email delivery (https://resend.com).
# Keep confidential; read exclusively server-side.
RESEND_API_KEY=""

# CONTACT_RECEIVER_EMAIL: Destination email address for received contact messages.
# Defaults to lalitchoudhary0907@gmail.com if unset.
CONTACT_RECEIVER_EMAIL="lalitchoudhary0907@gmail.com"

# RESEND_FROM_EMAIL: Verified sender address (e.g. "Portfolio <contact@yourdomain.com>").
RESEND_FROM_EMAIL="onboarding@resend.dev"

# PORT: Server listening port (defaults to 3000 in dev and Cloud Run)
PORT=3000

# OPTIONAL: Upstash Redis REST credentials for distributed multi-instance rate limiting.
# When provided, rate-limit counters synchronize atomically across horizontal serverless/container instances.
# If omitted, a high-performance in-memory sliding window store is used automatically.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


